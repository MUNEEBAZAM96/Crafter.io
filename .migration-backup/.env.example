# Copy to `.env.local` and fill in. Every value here is optional — the UI hides
# the corresponding link rather than rendering a placeholder or broken URL.

# Your LinkedIn profile, e.g. https://www.linkedin.com/in/your-handle
# Until this is set, every "Connect on LinkedIn" button is hidden.
NEXT_PUBLIC_LINKEDIN_URL=

# Google Play developer page for the studio, e.g.
# https://play.google.com/store/apps/dev?id=0000000000000000000
# Until this is set, Play Store buttons without an app-specific listing URL
# are hidden. Per-app listing URLs live in `lib/data/apps.ts` (`playStoreUrl`).
NEXT_PUBLIC_PLAY_STORE_URL=

# Production origin, used for canonical + Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://crafter.io
